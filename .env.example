# Copy to .env and fill in locally. Never commit .env (N-06).

# --- Feature flags (WO §16). Default OFF. Only the exact value "true" turns a flag on. ---
FEATURE_DEMAND_MAP=false
FEATURE_PUBLIC_JOBS=false
FEATURE_REFERRAL_REWARD=false
FEATURE_EMPLOYER_CANDIDATES=false

# --- Operator info for the footer (WO §13). Empty => placeholder text. ---
SITE_SERVICE_NAME=
SITE_ADMIN_SCRIVENER_OFFICE_NAME=
SITE_ADMIN_SCRIVENER_REG_NO=
SITE_JOB_PLACEMENT_REG_NO=
SITE_REPRESENTATIVE=
SITE_ADDRESS=

# --- Added in later phases ---
# P0b: DATABASE_URL, PG_DATA_DIR
# P0c: ENCRYPTION_KEYS, HASH_KEY
# P1b: AUTH_SECRET
# P1d: INGEST_API_KEY
# P2d: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS (leave empty => SMTP disabled)
