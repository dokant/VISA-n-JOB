# Copy to .env and fill in locally. Never commit .env (N-06).

# --- Feature flags (WO §16). Default OFF. Only the exact value "true" turns a flag on. ---
FEATURE_DEMAND_MAP=false
FEATURE_PUBLIC_JOBS=false
FEATURE_REFERRAL_REWARD=false
FEATURE_EMPLOYER_CANDIDATES=false

# --- Operator info (WO §13, src/config/site.config.ts). Empty => built-in default from SITE_INFO. ---
SITE_BRAND_WORDMARK=
SITE_BRAND_NAME_KO=
SITE_BRAND_TAGLINE=
SITE_ADMIN_SCRIVENER_OFFICE_NAME=
SITE_BUSINESS_REG_NO=
SITE_ADMIN_SCRIVENER_REG_NO=
SITE_JOB_PLACEMENT_NAME=
SITE_JOB_PLACEMENT_REG_NO=
SITE_REPRESENTATIVE=
SITE_ADDRESS=
SITE_PHONE=
SITE_EMAIL=
# Absolute site origin for canonical / hreflang / sitemap / JSON-LD (R-130). Empty => http://localhost:3000
SITE_URL=
# Internal only, never shown on public screens (DECISIONS Q-06). No default.
SITE_OPERATOR_MOBILE=
# Bank account details are intentionally NOT configurable here (Q-06).

# --- Database (P0b, local embedded Postgres; Q-02) ---
# Local-only development cluster started by `pnpm db:start` on 127.0.0.1:54320.
# The user/password below are created by initdb for this local cluster only (not a real credential).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54320/visanjob
# Cluster data directory. Empty => <repo>/.pgdata (git-ignored).
# If initdb/pg_ctl fails because of spaces or permissions in the repo path, use:
#   PG_DATA_DIR=%LOCALAPPDATA%/visanjob/pgdata
PG_DATA_DIR=
# Test cluster (Vitest globalSetup, port 54329). Empty => <repo>/.pgdata-test
PG_TEST_DATA_DIR=
# Optional dev admin account created by `pnpm db:seed` only when both are set (PC-15).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Field encryption and lookup hashes (P0c, src/lib/crypto.ts; R-008) ---
# Required as soon as the app reads or writes *Enc fields. Never commit real values.
# Generate each key with: openssl rand -base64 32
# ENCRYPTION_KEYS = comma-separated <version>:<base64 32-byte key>. The highest version encrypts new
# values; keep older versions listed until every row has been re-encrypted (key rotation).
ENCRYPTION_KEYS=
# HMAC-SHA256 key for *Hash lookup columns (base64, >= 32 bytes). Changing it breaks existing lookups.
HASH_KEY=
# Local development (DECISIONS Q-08): generate random keys once, store them only in your local .env.
#   node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"   # ENCRYPTION_KEYS
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"         # HASH_KEY
# Production keys are issued separately and never reuse development values.
# Tests never read these: tests/setup/env.ts generates throw-away keys per test file.

# --- Auth.js session signing (P1b, src/auth.ts; R-104 / R-118 / R-123) ---
# Random secret (>= 32 bytes), local .env only. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- Client address for per-IP rate limits (R-129, src/lib/rateLimit.ts clientIp) ---
# "true" ONLY when the app runs behind a reverse proxy that overwrites X-Forwarded-For with the real
# client address; the first X-Forwarded-For value is then used for the per-IP limits.
# Default (empty / false): forwarding headers are client-controlled and ignored. Next.js gives no
# socket address to route handlers / server actions, so the per-IP limits are skipped and only the
# per-phone / per-e-mail limits apply. The E2E servers set it to "true" (playwright.config.ts).
TRUST_PROXY=false

# --- Collector API key (P1d, POST /api/ingest/job-leads; R-114) ---
# Sent by the collector agent in the "x-api-key" header; compared in constant time. Random value of
# at least INGEST_API_KEY_MIN_LENGTH characters (src/config/limits.ts), local .env only
# (unset or shorter => every ingest call answers 401).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INGEST_API_KEY=

# --- Added in later phases ---
# P2d: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS (leave empty => SMTP disabled)
