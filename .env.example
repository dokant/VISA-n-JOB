# Copy to .env and fill in locally. Never commit .env (N-06).

# --- Feature flags (WO §16). Default OFF. Only the exact value "true" turns a flag on. ---
FEATURE_DEMAND_MAP=false
FEATURE_PUBLIC_JOBS=false
FEATURE_REFERRAL_REWARD=false
FEATURE_EMPLOYER_CANDIDATES=false

# --- Operator info (WO §13, src/config/site.config.ts). Empty => built-in default from SITE_INFO. ---
SITE_BRAND_WORDMARK=
SITE_BRAND_NAME_KO=
SITE_BRAND_TAGLINE=
SITE_ADMIN_SCRIVENER_OFFICE_NAME=
SITE_BUSINESS_REG_NO=
SITE_ADMIN_SCRIVENER_REG_NO=
SITE_JOB_PLACEMENT_NAME=
SITE_JOB_PLACEMENT_REG_NO=
SITE_REPRESENTATIVE=
SITE_ADDRESS=
SITE_PHONE=
SITE_EMAIL=
# Internal only, never shown on public screens (DECISIONS Q-06). No default.
SITE_OPERATOR_MOBILE=
# Bank account details are intentionally NOT configurable here (Q-06).

# --- Database (P0b, local embedded Postgres; Q-02) ---
# Local-only development cluster started by `pnpm db:start` on 127.0.0.1:54320.
# The user/password below are created by initdb for this local cluster only (not a real credential).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54320/visanjob
# Cluster data directory. Empty => <repo>/.pgdata (git-ignored).
# If initdb/pg_ctl fails because of spaces or permissions in the repo path, use:
#   PG_DATA_DIR=%LOCALAPPDATA%/visanjob/pgdata
PG_DATA_DIR=
# Test cluster (Vitest globalSetup, port 54329). Empty => <repo>/.pgdata-test
PG_TEST_DATA_DIR=
# Optional dev admin account created by `pnpm db:seed` only when both are set (PC-15).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Added in later phases ---
# P0c: ENCRYPTION_KEYS, HASH_KEY
# P1b: AUTH_SECRET
# P1d: INGEST_API_KEY
# P2d: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS (leave empty => SMTP disabled)
