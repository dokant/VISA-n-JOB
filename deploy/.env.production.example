# Visa&Job server settings (A-8, DECISIONS Q-31). Copy to deploy/.env on the server and fill in:
#   cp deploy/.env.production.example deploy/.env
#   node scripts/gen-secrets.ts deploy/.env     (fills the secrets and DATABASE_URL, prints names only)
# Staging: after that only SITE_URL, AUTH_URL, SEED_ADMIN_EMAIL and the basic auth lines are filled
# by a person (deploy/DEPLOY.md). deploy/.env is git-ignored and never committed. No real value
# belongs in this example. Values containing "$" (the basic auth hash) need single quotes: NAME='...'.

# --- Which services run ------------------------------------------------------------------------
# local-db: PostgreSQL runs on this server as the `db` container (staging, Q-31).
# Production with a managed database: empty (DEPLOY.md "운영 전환").
COMPOSE_PROFILES=local-db

# --- Public address ------------------------------------------------------------------------
# Absolute origin of the site: canonical / hreflang / sitemap / JSON-LD, links in e-mails, and the
# public origin of redirects (src/lib/publicOrigin.ts, QA O-9). Baked into static pages at build.
# Staging: https://staging.visanjob.co.kr   Production (later): https://visanjob.co.kr
SITE_URL=
# Auth.js public URL; same origin as SITE_URL (e.g. https://staging.visanjob.co.kr).
AUTH_URL=
# Caddy site address of the staging block (deploy/Caddyfile). Empty => staging.visanjob.co.kr
STAGING_DOMAIN=

# --- Staging basic auth (Caddy) ------------------------------------------------------------
# User name, and the bcrypt hash printed by `caddy hash-password` (DEPLOY.md). Single quotes.
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_HASH=

# --- Behind the proxy ------------------------------------------------------------------------
# Must be true on the server: Caddy overwrites X-Forwarded-For with the real client address,
# and the per-IP limits use it (src/lib/rateLimit.ts).
TRUST_PROXY=true

# --- Database ---------------------------------------------------------------------------------
# Staging (local-db): leave both empty — gen-secrets.ts writes POSTGRES_PASSWORD and
#   DATABASE_URL=postgresql://visanjob:<POSTGRES_PASSWORD>@db:5432/visanjob (internal network,
#   no sslmode, no CA). POSTGRES_PASSWORD is used only when the db volume is first created:
#   never change it afterwards.
# Production (managed database, later): DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
#   and the provider's root CA at deploy/certs/db-ca.pem (DEPLOY.md "운영 전환").
# Never the local embedded development ports 54320 / 54329 (the containers refuse to start).
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Backups (service `backup`, deploy/backup.sh) ----------------------------------------------
# Host folder of the daily database dump and private-files archive. Empty => /home/ubuntu/visanjob-backups
BACKUP_DIR=
# Number of daily sets kept. Empty => 14
BACKUP_KEEP=

# --- Secrets (scripts/gen-secrets.ts fills these; formats as in .env.example, Q-08) -----------
# Session signing secret.
AUTH_SECRET=
# Field encryption keys "<version>:<base64 32 bytes>". Never replace: stored data becomes
# unreadable. Back this file up separately from the database (DEPLOY.md).
ENCRYPTION_KEYS=
# HMAC key of the *Hash lookup columns. Never change after the first data.
HASH_KEY=
# Collector API key (x-api-key of POST /api/ingest/job-leads).
INGEST_API_KEY=

# --- First admin account (prisma/seed, `docker compose run --rm seed`) --------------------------
# Created once when both are set; remove the password line after the first sign-in (DEPLOY.md).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Fake sample seekers: always false on a server (also refused when NODE_ENV=production).
SEED_SAMPLE_SEEKERS=false

# --- Private uploads ---------------------------------------------------------------------------
# Path inside the app container; the named volume private-files is mounted there.
PRIVATE_STORAGE_DIR=/data/private

# --- Feature flags (WO §16): false until the legal review (PLAN A-5) ----------------------------
# Baked into static pages at build: a change needs a rebuild (DEPLOY.md).
FEATURE_DEMAND_MAP=false
FEATURE_PUBLIC_JOBS=false
FEATURE_REFERRAL_REWARD=false
FEATURE_EMPLOYER_CANDIDATES=false

# --- Operator info (src/config/site.config.ts). Empty => built-in defaults (SITE_INFO). ----------
# Public values, baked into static pages at build.
SITE_BRAND_WORDMARK=
SITE_BRAND_NAME_KO=
SITE_BRAND_TAGLINE=
SITE_ADMIN_SCRIVENER_OFFICE_NAME=
SITE_BUSINESS_REG_NO=
SITE_ADMIN_SCRIVENER_REG_NO=
SITE_JOB_PLACEMENT_NAME=
SITE_JOB_PLACEMENT_REG_NO=
SITE_REPRESENTATIVE=
SITE_ADDRESS=
SITE_PHONE=
SITE_EMAIL=
# Internal only, never shown publicly (Q-06). Not a build argument.
SITE_OPERATOR_MOBILE=

# --- E-mail (A-3, separate approval): leave ALL empty until a person approves real sending ------
# Empty SMTP_HOST => console adapter only; the worker then logs that the 14-day status-check
# transition is disabled (Q-27). That warning is expected on staging.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Image tag (optional) ---------------------------------------------------------------------
# docker compose tags the image visanjob-app:${IMAGE_TAG}; e.g. the git commit for rollbacks.
IMAGE_TAG=
