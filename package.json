{
  "name": "visanjob",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "qa:static": "tsx scripts/qa-static.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "db:start": "tsx scripts/db.ts start",
    "db:stop": "tsx scripts/db.ts stop",
    "db:status": "tsx scripts/db.ts status",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "tsx scripts/db.ts reset",
    "db:studio": "prisma studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embedded-postgres": "17.9.0-beta.17",
    "lucide-react": "^0.577.0",
    "next": "^15.5.29",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.15.1",
    "next-mdx-remote": "^5.0.0",
    "nodemailer": "^6.10.1",
    "otplib": "^12.0.1",
    "pg-boss": "^10.4.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "husky": "^9.1.7",
    "lighthouse": "^12.8.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
